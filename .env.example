# Copy to .env for local development. Never commit the real .env.
# On Vercel, set these under Project Settings -> Environment Variables instead.

# Signs the session cookie. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to boot in production without this.
SECRET_KEY=

# Neon connection string. Use the POOLED endpoint (the host contains "-pooler"),
# otherwise every serverless invocation opens a direct connection and you will
# exhaust the database's connection limit.
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/cortexone?sslmode=require
DATABASE_URL=

# Rotate this key before deploying — the old one was printed to Render's logs.
OPENAI_API_KEY=

# Model IDs are configurable because OpenAI's lineup changes often.
# Verify against your account's model list before deploying.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TITLE_MODEL=gpt-5.4-nano

# How much prior conversation to replay to the model on each turn.
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARS=24000

# Per-user message cap, rolling one-hour window. 0 disables the limit.
RATE_LIMIT_PER_HOUR=120

# Set to "development" locally to relax cookie security for plain HTTP.
FLASK_ENV=production
